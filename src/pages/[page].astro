---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const posts = await getCollection('posts', ({ data }: { data: { draft: boolean } }) => !data.draft);
  posts.sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props as any;
const isFirstPage = page.currentPage === 1;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: '2-digit',
    year: 'numeric',
  }).toUpperCase();
}

function pad(n: number) {
  return String(n).padStart(2, '0');
}
---

<BaseLayout title="ZORTH">
  {isFirstPage && (
    <section class="mb-12 pb-12" style="border-bottom: 1px solid var(--border);">
      <h1
        class="text-5xl md:text-6xl leading-tight mb-6"
        style="font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-weight: 700; color: var(--text);"
      >
        日拱一卒，<br />功不唐捐。
      </h1>
      <p class="text-base max-w-xl leading-relaxed" style="color: var(--text-muted);">
        分享技术探索、阅读笔记和生活随笔。持续更新中。
      </p>
    </section>
  )}

  <section>
    <ul id="post-list" class="space-y-0">
      {page.data.map((post: any, i: number) => {
        const globalIndex = (page.currentPage - 1) * 10 + i + 1;
        return (
          <li style="border-top: 1px solid var(--border);">
            <a
              href={`/posts/${post.id}/`}
              class="flex gap-6 py-6 group"
              style="text-decoration: none;"
            >
              <span
                class="text-sm font-mono pt-0.5 flex-shrink-0 w-6"
                style="color: var(--text-muted);"
              >
                {pad(globalIndex)}
              </span>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-1">
                  <h2
                    class="text-base font-semibold leading-snug group-hover:opacity-70 transition-opacity"
                    style="color: var(--text);"
                  >
                    {post.data.title}
                  </h2>
                  <time
                    class="text-xs flex-shrink-0 font-mono"
                    datetime={post.data.pubDate.toISOString()}
                    style="color: var(--text-muted);"
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                </div>
                {post.data.description && (
                  <p class="text-sm leading-relaxed mb-2 line-clamp-2" style="color: var(--text-muted);">
                    {post.data.description}
                  </p>
                )}
              </div>
            </a>
          </li>
        );
      })}
    </ul>

    {(page.url.prev || page.url.next) && (
      <div id="pagination" class="mt-8 pt-6 flex items-center justify-between text-sm" style="border-top: 1px solid var(--border);">
        <div>
          {page.url.prev ? (
            <a href={page.url.prev} style="color: var(--text-muted);" class="hover:opacity-70 transition-opacity">
              &larr; 上一页
            </a>
          ) : (
            <span style="color: var(--border);">&larr; 上一页</span>
          )}
        </div>
        <span class="text-xs font-mono" style="color: var(--text-muted);">
          {page.currentPage} / {page.lastPage}
        </span>
        <div>
          {page.url.next ? (
            <a href={page.url.next} style="color: var(--text-muted);" class="hover:opacity-70 transition-opacity">
              下一页 &rarr;
            </a>
          ) : (
            <span style="color: var(--border);">下一页 &rarr;</span>
          )}
        </div>
      </div>
    )}
  </section>
</BaseLayout>

